{
  "id": null,
  "uid": null,
  "title": "Spring Boot",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Total Requests Per Minute",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count[1m]))",
          "legendFormat": "all requests",
          "interval": "1m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/min"
        }
      },
      "options": {
        "legend": { "displayMode": "list" }
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}